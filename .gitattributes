# Auto detect text files and perform LF normalization
* text=auto

# Source files: always LF
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.svg  text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# Keep vendored and generated code out of language stats and diffs
templates/orbital/assets/js/vendor/** linguist-vendored -diff
*.min.js linguist-vendored -diff
docs/** linguist-documentation
